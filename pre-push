#!/usr/bin/env bash
# pre-push: enforce push policy.
#   - only the 'dev' branch may be pushed (main is protected via GitHub
#     branch protection + required status checks; land changes through PR)
#   - reject if any commit being pushed contains forbidden tokens:
#     traeagent, co-authored-by, and variants (see commit-msg)
#   - reject if any commit being pushed has an author/committer email
#     other than 602187256@qq.com  (prevents noreply / split-identity history)
#   - run `cargo test --all` before the push goes through
#
# The email scan closes the gap that let noreply commits land on origin/main
# in the first place: pre-commit only checks the *current* config/env, so a
# commit made before the hook was installed (or with --no-verify) could still
# carry a wrong email and be pushed. pre-push sees the actual commit objects
# in the push range and rejects them at the last checkpoint.
set -euo pipefail

allowed_branch="dev"
required_email="602187256@qq.com"
# Keep this in sync with commit-msg's forbidden_re.
forbidden_re='trae[^a-z]*agent|co-?authored[ -]by|generated[ -](by|with)[ -]trae'

# `cargo test` is expensive; run it once for the whole push, not per ref.
# We only run it if the push contains source changes -- detect by checking
# whether any .rs file differs between the push range and its merge base.
run_tests_if_needed() {
    local range="$1"
    # For a new branch (range == single sha), compare against origin/dev.
    local diff_range="$range"
    if ! git rev-parse --verify "$range" >/dev/null 2>&1; then
        diff_range="origin/dev..$range"
    fi
    # Only run tests if .rs files changed in the push range.
    if git diff --name-only "$diff_range" -- 2>/dev/null | grep -q '\.rs$'; then
        echo "pre-push: running cargo test --all (.rs changes detected)" >&2
        if ! cargo test --all; then
            echo "pre-push: reject" >&2
            echo "  cargo test failed. Fix the failing tests before pushing." >&2
            exit 1
        fi
    fi
}

while read -r local_ref local_sha remote_ref remote_sha; do
    # remote_ref looks like refs/heads/<branch>.
    branch="${remote_ref#refs/heads/}"
    if [ "$branch" != "$allowed_branch" ]; then
        echo "pre-push: reject" >&2
        echo "  pushing to branch '$branch', only '$allowed_branch' is allowed" >&2
        exit 1
    fi

    # Scan every commit in the push range for forbidden tokens.
    # remote_sha may be all-zeros for a new branch (first push of that
    # branch). Previously this fell back to `range="$local_sha"`, which
    # makes `git log "$local_sha"` scan the ENTIRE history reachable from
    # the tip - including commits already merged into the protected
    # branch (origin/main) via GitHub PRs. Those squash/merge commits
    # carry `committer=GitHub <noreply@github.com>` and would trip the
    # identity check below, blocking every new-branch push even though
    # the offending commits are historical and cannot be rewritten
    # without force-pushing main.
    #
    # Fix: derive the scan range from a remote tracking branch so only
    # NEW commits (those not yet on the remote) are scanned. Try
    # origin/HEAD first (points to the remote default branch), then
    # origin/main, then origin/master. Fall back to the tip commit
    # only if no remote tracking branch exists (orphan branch).
    range="$remote_sha..$local_sha"
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        base=""
        for ref in origin/HEAD origin/main origin/master; do
            if git rev-parse --verify "$ref" >/dev/null 2>&1; then
                base="$ref"
                break
            fi
        done
        if [ -n "$base" ]; then
            range="$base..$local_sha"
        else
            # Orphan branch with no known remote base: scan just the tip.
            range="$local_sha"
        fi
    fi

    if git log --format='%B' "$range" | grep -niE "$forbidden_re" >/dev/null 2>&1; then
        echo "pre-push: reject" >&2
        echo "  pushed commits contain a forbidden token (trae agent / co-authored-by)" >&2
        echo "  offending commit:" >&2
        git log --format='%h %s' "$range" | grep -iE "$forbidden_re" | head -1 | sed 's/^/    /' >&2
        exit 1
    fi

    # Reject any commit whose author OR committer email is not the required one.
    # Uses %ae/%ce (raw, verbatim from the commit object) so rewritten history
    # is caught too. Print the first offender so the user knows which commit
    # to rewrite.
    bad_identity=$(git log --format='%h | author: %an <%ae> | committer: %cn <%ce>' "$range" \
        | awk -v req="$required_email" '
            /<[^>]+>/ {
                # extract the two email addresses between < and >
                line=$0
                # pull author email
                match(line, /author: [^<]*<([^>]+)>/, a)
                # pull committer email
                match(line, /committer: [^<]*<([^>]+)>/, c)
                if (a[1] != req || c[1] != req) { print; exit }
            }
        ')
    if [ -n "$bad_identity" ]; then
        echo "pre-push: reject" >&2
        echo "  a pushed commit has an author/committer email != $required_email" >&2
        echo "  (this is what caused noreply to leak into the history before)" >&2
        echo "  offending commit:" >&2
        echo "    $bad_identity" >&2
        echo "  fix: rewrite history with git filter-branch / filter-repo, or drop the commit." >&2
        exit 1
    fi
done

# Run tests once after all refs are validated.
# Re-derive the range from the last ref read (the only one we allow is main).
run_tests_if_needed "${range:-HEAD}"

exit 0
