#!/usr/bin/env bash
# pre-push: enforce push policy.
#   - tag pushes (refs/tags/*):
#       - skip branch + identity checks (tags are not branch commits)
#       - annotated tags: validate message is ASCII-only English and
#         contains no forbidden tokens
#       - lightweight tags: no message, pass through
#   - branch pushes:
#       - branch must match an entry in hook-rules.conf [allowed_branches]
#         (exact match, or prefix match when entry ends with `*`)
#       - reject if any commit being pushed contains forbidden tokens
#         (read from [forbidden_tokens]; normalized match)
#       - reject if any commit being pushed has an author/committer email
#         NOT in [identities]. Catches noreply / split identity history
#         that slipped in via --no-verify or pre-hook commits.
#       - run `cargo test --all` before the push goes through
#
# The email scan closes the gap that let noreply commits land on origin/main
# in the first place: pre-commit only checks the *current* config/env, so a
# commit made before the hook was installed (or with --no-verify) could still
# carry a wrong email and be pushed. pre-push sees the actual commit objects
# in the push range and rejects them at the last checkpoint.
set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=load-config.sh
. "$HOOKS_DIR/load-config.sh"
# shellcheck source=lang-detector.sh
. "$HOOKS_DIR/lang-detector.sh"
# shellcheck source=lang-runner.sh
. "$HOOKS_DIR/lang-runner.sh"

# Fail closed: missing config or empty required sections.
if [ "$config_load_ok" != "1" ]; then
    echo "pre-push: reject" >&2
    echo "  hook-rules.conf not found at: $config_file" >&2
    exit 1
fi
if ! config_section_nonempty identities; then
    echo "pre-push: reject" >&2
    echo "  [identities] section is missing or empty in hook-rules.conf." >&2
    echo "  fail closed by design." >&2
    exit 1
fi
if ! config_section_nonempty allowed_branches; then
    echo "pre-push: reject" >&2
    echo "  [allowed_branches] section is missing or empty in hook-rules.conf." >&2
    echo "  fail closed by design." >&2
    exit 1
fi
if ! config_section_nonempty forbidden_tokens; then
    echo "pre-push: reject" >&2
    echo "  [forbidden_tokens] section is missing or empty in hook-rules.conf." >&2
    echo "  fail closed by design." >&2
    exit 1
fi

# Run language tests once for the whole push, not per ref.
# Detects languages from files changed in the push range and runs each
# language's `test` stage from hook-rules.conf [lang_tools]. A docs-only
# push (no source suffix) skips every test suite.
run_tests_if_needed() {
    local range="$1"
    # For a new branch (range == single sha), find a remote-tracking base
    # to diff against. Try origin/HEAD (remote default branch) first,
    # then origin/main / origin/master. Fall back to the tip itself if
    # no remote ref exists (orphan branch).
    local diff_range="$range"
    if ! git rev-parse --verify "$range" >/dev/null 2>&1; then
        local base=""
        for ref in origin/HEAD origin/main origin/master; do
            if git rev-parse --verify "$ref" >/dev/null 2>&1; then
                base="$ref"
                break
            fi
        done
        if [ -n "$base" ]; then
            diff_range="$base..$range"
        else
            diff_range="$range"
        fi
    fi
    local changed_files
    changed_files=$(git diff --name-only "$diff_range" -- 2>/dev/null)
    if [ -z "$changed_files" ]; then
        return 0
    fi
    if ! run_all_langs_stage test "$changed_files"; then
        echo "pre-push: reject" >&2
        echo "  a language test suite failed. Fix the failing tests before pushing." >&2
        exit 1
    fi
}

# Validate an annotated tag's message:
#   - ASCII only (English-only rule, same as commit-msg)
#   - no forbidden tokens (same matcher as commit-msg)
# Lighter than commit-msg: no length cap, no conventional-commits prefix
# (tags do not need to follow commit conventions).
validate_tag_message() {
    local tag_name="$1"
    local tag_sha="$2"
    # Annotated tags are objects of type `tag`; lightweight tags point
    # directly at a commit and have no message to validate.
    local tag_type
    tag_type=$(git cat-file -t "$tag_sha" 2>/dev/null || echo "")
    if [ "$tag_type" != "tag" ]; then
        return 0
    fi

    local tag_msg
    tag_msg=$(git for-each-ref --format='%(contents)' "refs/tags/$tag_name")

    # ASCII-only check.
    if printf '%s' "$tag_msg" | LC_ALL=C tr -d '\000-\177' | grep -q .; then
        echo "pre-push: reject" >&2
        echo "  tag $tag_name message contains non-ASCII characters; English only" >&2
        exit 1
    fi

    # Forbidden-token check (normalized match).
    if message_has_forbidden "$tag_msg"; then
        echo "pre-push: reject" >&2
        echo "  tag $tag_name message contains a forbidden token" >&2
        exit 1
    fi
}

last_range=""

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/*)
            # Tag push: skip branch + identity checks. Validate message
            # for annotated tags only; lightweight tags carry no message.
            tag_name="${remote_ref#refs/tags/}"
            validate_tag_message "$tag_name" "$local_sha"
            continue
            ;;
        refs/heads/*)
            branch="${remote_ref#refs/heads/}"
            ;;
        *)
            # Other ref types (e.g. refs/remotes/*): skip silently.
            continue
            ;;
    esac

    # Branch deletion: both shas are all-zeros. Nothing to scan, no
    # identity to check -- the branch is being removed, not added to.
    # Skip silently; the remote will perform the actual deletion.
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ] \
       && [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    if ! branch_allowed "$branch"; then
        echo "pre-push: reject" >&2
        echo "  pushing to branch '$branch', not in [allowed_branches]:" >&2
        get_allowed_branches | sed 's/^/    /' >&2
        exit 1
    fi

    # Scan every commit in the push range for forbidden tokens.
    # remote_sha may be all-zeros for a new branch (first push of that
    # branch). Previously this fell back to `range="$local_sha"`, which
    # makes `git log "$local_sha"` scan the ENTIRE history reachable from
    # the tip - including commits already merged into the protected
    # branch (origin/main) via GitHub PRs. Those squash/merge commits
    # carry `committer=GitHub <noreply@github.com>` and would trip the
    # identity check below, blocking every new-branch push even though
    # the offending commits are historical and cannot be rewritten
    # without force-pushing main.
    #
    # Fix: derive the scan range from a remote tracking branch so only
    # NEW commits (those not yet on the remote) are scanned. Try
    # origin/HEAD first (points to the remote default branch), then
    # origin/main, then origin/master. Fall back to the tip commit
    # only if no remote tracking branch exists (orphan branch).
    range="$remote_sha..$local_sha"
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        base=""
        for ref in origin/HEAD origin/main origin/master; do
            if git rev-parse --verify "$ref" >/dev/null 2>&1; then
                base="$ref"
                break
            fi
        done
        if [ -n "$base" ]; then
            range="$base..$local_sha"
        else
            # Orphan branch with no known remote base: scan just the tip.
            range="$local_sha"
        fi
    fi
    last_range="$range"

    # Forbidden-token scan across all commit messages in the push range.
    # Use git log %B (raw body) so multi-line messages are scanned in full.
    bad_token=""
    while IFS= read -r commit_body; do
        if message_has_forbidden "$commit_body"; then
            bad_token=1
            break
        fi
    done < <(git log --format='%B' "$range")
    if [ -n "$bad_token" ]; then
        echo "pre-push: reject" >&2
        echo "  pushed commits contain a forbidden token (trae agent / co-authored-by / generated by trae)" >&2
        git log --format='%h %s' "$range" | head -5 | sed 's/^/    /' >&2
        exit 1
    fi

    # Reject any commit whose author OR committer email is NOT in the
    # allowlist. Uses %ae/%ce (raw, verbatim from the commit object) so
    # rewritten history is caught too. Print the first offender so the
    # user knows which commit to rewrite.
    #
    # Implementation note: we avoid gawk's 3-arg match() with capture
    # groups (match(line, /pat/, arr)) because BSD awk on macOS does not
    # support it and silently produces empty captures. Instead git log
    # emits `h|ae|ce|an|cn` pipe-delimited fields and bash parses them.
    allowed_tmp=$(mktemp)
    get_identities | grep -oE '<[^>]+>' | tr -d '<>' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' > "$allowed_tmp"
    bad_identity=""
    while IFS='|' read -r h ae ce an cn; do
        # Skip empty (e.g. blank trailing line)
        [ -z "$h" ] && continue
        if ! grep -Fxq -- "$ae" "$allowed_tmp" || ! grep -Fxq -- "$ce" "$allowed_tmp"; then
            bad_identity="$h | author: $an <$ae> | committer: $cn <$ce>"
            break
        fi
    done < <(git log --format='%h|%ae|%ce|%an|%cn' "$range")
    rm -f "$allowed_tmp"
    if [ -n "$bad_identity" ]; then
        echo "pre-push: reject" >&2
        echo "  a pushed commit has an author/committer email not in the allowlist." >&2
        echo "  (this is what caused noreply to leak into the history before)" >&2
        echo "  offending commit:" >&2
        echo "    $bad_identity" >&2
        echo "  allowed emails:" >&2
        get_identities | grep -oE '<[^>]+>' | tr -d '<>' \
            | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | sed 's/^/    /' >&2
        echo "  fix: rewrite history with git filter-branch / filter-repo, or drop the commit." >&2
        exit 1
    fi
done

# Run tests once after all refs are validated.
# Re-derive the range from the last branch ref read (tag pushes do not
# trigger cargo test -- they do not change source, only metadata).
if [ -n "$last_range" ]; then
    run_tests_if_needed "$last_range"
fi

exit 0
