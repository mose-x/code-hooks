#!/usr/bin/env bash
# commit-msg: enforce commit message rules.
#   - subject line <= max_subject_length (from hook-rules.conf [rules])
#   - subject line does not end with '.'
#   - subject must start with a conventional-commits type
#     (from hook-rules.conf [commit_types])
#   - no forbidden tokens anywhere: read from [forbidden_tokens],
#     matched after normalizing non-alphanumeric chars to a single space
#   - message must be English only (pure ASCII): no CJK, emoji, ...
#   - total message length (subject + body) <= max_total_message_length
#     (UTF-8 codepoint count)
set -euo pipefail

msg_file="$1"

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=load-config.sh
. "$HOOKS_DIR/load-config.sh"

# Fail closed: missing config or empty required sections.
if [ "$config_load_ok" != "1" ]; then
    echo "commit-msg: reject" >&2
    echo "  hook-rules.conf not found at: $config_file" >&2
    exit 1
fi
if ! config_section_nonempty forbidden_tokens; then
    echo "commit-msg: reject" >&2
    echo "  [forbidden_tokens] section is missing or empty in hook-rules.conf." >&2
    echo "  fail closed by design." >&2
    exit 1
fi
if ! config_section_nonempty commit_types; then
    echo "commit-msg: reject" >&2
    echo "  [commit_types] section is missing or empty in hook-rules.conf." >&2
    echo "  fail closed by design." >&2
    exit 1
fi

# Read scalar rules, falling back to the historical defaults so a missing
# [rules] entry does not silently disable a length cap.
max_len=$(get_rule max_subject_length)
[ -n "$max_len" ] || max_len=100
total_max=$(get_rule max_total_message_length)
[ -n "$total_max" ] || total_max=200

# Read the first non-comment, non-empty line as the subject.
subject=""
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in \#*) continue;; esac
    [ -z "$line" ] && continue
    subject="$line"
    break
done < "$msg_file"

# Rule 1: subject length <= max_subject_length.
len=${#subject}
if [ "$len" -gt "$max_len" ]; then
    echo "commit-msg: reject" >&2
    echo "  subject line is $len chars (max $max_len):" >&2
    echo "  $subject" >&2
    exit 1
fi

# Rule 2: subject must not end with '.'.
case "$subject" in
    *.)
        echo "commit-msg: reject" >&2
        echo "  subject line ends with '.', which is not allowed:" >&2
        echo "  $subject" >&2
        exit 1
        ;;
esac

# Rule 3: subject must start with a conventional-commits type.
# Build the type alternation from [commit_types] at runtime: one type
# per line gets joined with `|` into `(t1|t2|...)`.
# Allows an optional scope "(...)" and a "!" for breaking changes.
types_re=$(get_commit_types | paste -sd '|' -)
conventional_re="^(${types_re})(\([^)]+\))?!?: .+"
if ! printf '%s' "$subject" | grep -qE "$conventional_re"; then
    echo "commit-msg: reject" >&2
    echo "  subject must follow conventional commits: '<type>(<scope>)!: <desc>'" >&2
    echo "  allowed types: $(get_commit_types | paste -sd ' ' -)" >&2
    echo "  subject was: $subject" >&2
    exit 1
fi

# Rule 4: no forbidden tokens anywhere in the full message.
# Uses the shared matcher from load-config.sh, which normalizes
# non-alphanumeric chars to a single space and lowercases before
# substring match. This catches `trae agent` / `trae-agent` /
# `traeagent` / `Co-authored-by` / etc. with one entry each.
full_msg=$(sed '/^#/d' "$msg_file")
if message_has_forbidden "$full_msg"; then
    echo "commit-msg: reject" >&2
    echo "  message contains a forbidden token (trae agent / co-authored-by / generated by trae)" >&2
    exit 1
fi

# Rule 5: message must be English only (pure ASCII).
# Reject any non-ASCII byte (CJK, emoji, curly quotes, arrows, ellipsis).
# LC_ALL=C forces byte-mode so a single multi-byte UTF-8 char is flagged.
# Strip git comment lines first so they don't affect the check.
if sed '/^#/d' "$msg_file" | LC_ALL=C tr -d '\000-\177' | grep -q .; then
    echo "commit-msg: reject" >&2
    echo "  message contains non-ASCII characters; English (ASCII) only:" >&2
    sed '/^#/d' "$msg_file" | LC_ALL=C grep -nE '[^ -~]' | head -1 | sed 's/^/  /' >&2
    exit 1
fi

# Rule 6: total message length (subject + body, excluding git comment lines
# and trailing whitespace) must be <= max_total_message_length UTF-8 codepoints.
# Python is preferred for correct UTF-8 codepoint counting (bash ${#var}
# depends on locale; python3 len() counts codepoints unconditionally). Fall
# back to `wc -m` under the C locale when python3 is absent (minimal Docker
# images, etc.). `wc -m` in C locale counts bytes, which is a conservative
# upper bound for multi-byte UTF-8 -> may reject borderline messages that
# python3 would pass, but never lets an over-long message through.
if command -v python3 >/dev/null 2>&1; then
    total_len=$(sed '/^#/d' "$msg_file" | python3 -c 'import sys; print(len(sys.stdin.read().rstrip()))')
else
    # Reassemble without trailing newlines, rstrip trailing whitespace
    # (matching python's rstrip), then count bytes under C locale. Bytes
    # >= codepoints for UTF-8, so this is a conservative upper bound:
    # never lets an over-long message through, may reject a borderline
    # multi-byte one that python3 passes.
    total_len=$(sed '/^#/d' "$msg_file" \
        | awk 'NR>1{printf "\n"} {sub(/[[:space:]]+$/,""); printf "%s", $0}' \
        | LC_ALL=C wc -m | awk '{print $1}')
fi
if [ "$total_len" -gt "$total_max" ]; then
    echo "commit-msg: reject" >&2
    echo "  total message is $total_len chars (max $total_max); subject+body must be terser" >&2
    exit 1
fi

exit 0
