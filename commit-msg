#!/usr/bin/env bash
# commit-msg: enforce commit message rules.
#   - subject line <= 100 chars
#   - subject line does not end with '.'
#   - subject must start with a conventional-commits type
#     (feat|fix|refactor|perf|test|style|docs|ci|chore|build|revert)
#   - no forbidden tokens anywhere: traeagent, Co-authored-by, and variants
#   - message must be English only (pure ASCII): no CJK, emoji, curly quotes, ...
set -euo pipefail

msg_file="$1"
max_len=100

# Read the first non-comment, non-empty line as the subject.
subject=""
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in \#*) continue;; esac
    [ -z "$line" ] && continue
    subject="$line"
    break
done < "$msg_file"

# Rule 1: subject length <= 100.
len=${#subject}
if [ "$len" -gt "$max_len" ]; then
    echo "commit-msg: reject" >&2
    echo "  subject line is $len chars (max $max_len):" >&2
    echo "  $subject" >&2
    exit 1
fi

# Rule 2: subject must not end with '.'.
case "$subject" in
    *.)
        echo "commit-msg: reject" >&2
        echo "  subject line ends with '.', which is not allowed:" >&2
        echo "  $subject" >&2
        exit 1
        ;;
esac

# Rule 3: subject must start with a conventional-commits type.
# Allows an optional scope "(...)" and a "!" for breaking changes.
# Matches the prefixes already used 100% in this repo's history.
# Examples that pass: "fix: ...", "feat(api): ...", "refactor!: ...".
# Examples that fail: "update something", "Fix bug", "WIP".
conventional_re='^(feat|fix|refactor|perf|test|style|docs|ci|chore|build|revert)(\([^)]+\))?!?: .+'
if ! printf '%s' "$subject" | grep -qE "$conventional_re"; then
    echo "commit-msg: reject" >&2
    echo "  subject must follow conventional commits: '<type>(<scope>)!: <desc>'" >&2
    echo "  allowed types: feat fix refactor perf test style docs ci chore build revert" >&2
    echo "  subject was: $subject" >&2
    exit 1
fi

# Rule 4: no forbidden tokens anywhere in the full message.
# Extended beyond the literal words to catch common bypass attempts:
#   - "traeagent" / "trae agent" / "trae-agent"  (with any separator)
#   - "Co-authored-by" / "Co-authored by"        (with or without the dash)
#   - "Generated by trae" / "Generated with trae" (the trae agent signature)
# Case-insensitive. The `[^a-z]*` between trae and agent tolerates spaces,
# dashes, underscores, and even nothing (so "traeagent" itself still hits).
forbidden_re='trae[^a-z]*agent|co-?authored[ -]by|generated[ -](by|with)[ -]trae'
if sed '/^#/d' "$msg_file" | grep -niE "$forbidden_re" >/dev/null 2>&1; then
    echo "commit-msg: reject" >&2
    echo "  message contains a forbidden token (trae agent / co-authored-by / generated by trae)" >&2
    exit 1
fi

# Rule 5: message must be English only (pure ASCII).
# Reject any non-ASCII byte (CJK, emoji, curly quotes, arrows, ellipsis).
# LC_ALL=C forces byte-mode so a single multi-byte UTF-8 char is flagged.
# Strip git comment lines first so they don't affect the check.
if sed '/^#/d' "$msg_file" | LC_ALL=C tr -d '\000-\177' | grep -q .; then
    echo "commit-msg: reject" >&2
    echo "  message contains non-ASCII characters; English (ASCII) only:" >&2
    sed '/^#/d' "$msg_file" | LC_ALL=C grep -nE '[^ -~]' | head -1 | sed 's/^/  /' >&2
    exit 1
fi

exit 0
