#!/usr/bin/env bash
# pre-commit: enforce identity AND code quality.
#
# Identity (always on):
#   - author    email must be in the allowlist (hook-rules.conf [identities])
#   - committer email must be in the allowlist
#     (GIT_COMMITTER_EMAIL override is checked too)
#
# The allowlist is read from $HOOKS_DIR/hook-rules.conf (committed).
# No local override -- the repo owner solely controls who can commit.
#
# Code quality (only when src/**/*.rs is staged):
#   - `cargo fmt --check`          (formatting)
#   - `cargo clippy -D warnings`   (lints, deny warnings)
#
# The cargo checks are gated on .rs changes so docs-only / hook-only commits
# are not penalised with a multi-second compile.
set -euo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"

# shellcheck source=load-config.sh
. "$HOOKS_DIR/load-config.sh"

# Fail closed: missing config file or empty [identities] section blocks
# every commit. This prevents a fresh clone of code-hooks from silently
# running with no identity enforcement.
if [ "$config_load_ok" != "1" ]; then
    echo "pre-commit: reject" >&2
    echo "  hook-rules.conf not found at: $config_file" >&2
    echo "  fail closed by design -- the repo owner must add an identity." >&2
    exit 1
fi
if ! config_section_nonempty identities; then
    echo "pre-commit: reject" >&2
    echo "  [identities] section is missing or empty in hook-rules.conf." >&2
    echo "  fail closed by design -- the repo owner must add an identity." >&2
    exit 1
fi

author_email=$(git config user.email)
if ! email_in_allowlist "$author_email"; then
    echo "pre-commit: reject" >&2
    echo "  user.email (author) is '$author_email', not in allowlist:" >&2
    get_identities | grep -oE '<[^>]+>' | tr -d '<>' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | sed 's/^/    /' >&2
    echo "  fix: git config user.email '<one of the above>'" >&2
    exit 1
fi

# GIT_COMMITTER_EMAIL overrides the configured email for the committer field.
# When unset, git falls back to user.email, so we only need to check when it
# IS set -- but if it is set and disagrees, that is an identity split.
committer_email="${GIT_COMMITTER_EMAIL:-}"
if [ -n "$committer_email" ] && ! email_in_allowlist "$committer_email"; then
    echo "pre-commit: reject" >&2
    echo "  GIT_COMMITTER_EMAIL is '$committer_email', not in allowlist:" >&2
    get_identities | grep -oE '<[^>]+>' | tr -d '<>' \
        | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | sed 's/^/    /' >&2
    echo "  Either unset GIT_COMMITTER_EMAIL or set it to one of the above." >&2
    echo "  Leaving it set to an unlisted address creates a split identity on GitHub." >&2
    exit 1
fi

# --- Code quality: fmt + lint for detected languages ---
# Detects languages by staged file suffix and runs the fmt + lint commands
# configured in hook-rules.conf [lang_tools]. Docs-only commits (no source
# suffix) skip every tool -- same fast path as the previous Rust-only gate.
# shellcheck source=lang-detector.sh
. "$HOOKS_DIR/lang-detector.sh"
# shellcheck source=lang-runner.sh
. "$HOOKS_DIR/lang-runner.sh"

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged_files" ]; then
    if ! run_all_langs_stage fmt "$staged_files"; then
        exit 1
    fi
    if ! run_all_langs_stage lint "$staged_files"; then
        exit 1
    fi
fi

exit 0
